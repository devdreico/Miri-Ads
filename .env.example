# Copia a .env y ajusta los valores

# --- Base de datos (Postgres 16 via docker-compose, puerto 5433) ---
DATABASE_URL="postgresql://miri:miri@localhost:5433/miri_ads?schema=public"

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- MercadoPago (modo sandbox/test) ---
# Si está vacío, el checkout funciona en MODO DEMO (sin cobro real).
MP_ACCESS_TOKEN=""
MP_PUBLIC_BASE_URL="http://localhost:3000"
MP_WEBHOOK_SECRET=""

# --- Subida de evidencias ---
MAX_UPLOAD_MB="25"
